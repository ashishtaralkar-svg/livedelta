# Copy this to .env.strangle9pmladder2 and fill in your credentials.
# This file is safe to commit; .env.strangle9pmladder2 is gitignored.
#
# INTENDED TO RUN ON A SEPARATE DELTA SUB-ACCOUNT (its own capital/API keys),
# as an independent container parallel to the other bots. Do NOT point this
# at an account already running another bot -- separate capital means they
# can never collide on position ownership.

# --- Credentials (the SUB-ACCOUNT's own API key/secret -- NOT the main account) ---
DELTA_API_KEY=your_sub_account_api_key_here
DELTA_API_SECRET=your_sub_account_api_secret_here

# --- Exchange ---
DELTA_TESTNET=false
DELTA_REGION=india
DELTA_SYMBOL=BTCUSD

# --- Strategy: Daily 9PM IST 2-TIER LADDERED Short Strangle -- the SAME
# engine as strangle9pmladderbot (DELTA_STRATEGY=strangle9pmladder), just
# configured for TWO OTM%% tiers (1%/1.5%, 4 legs total: ce_1, pe_1, ce_1_5,
# pe_1_5) instead of three. ALL FOUR legs open together and close together
# as ONE combined position -- target/SL are evaluated on the SUM of every
# leg's current buyback premium against the SUM of every leg's entry
# premium, same formulas as strangle9pmbot/strangle9pmladderbot:
#  * TARGET: combined premium decayed to <= entry * (1 - DELTA_STRANGLE9PM_TARGET_PCT/100)
#  * SL:     combined premium rose to >= entry * (1 + DELTA_STRANGLE9PM_SL_PCT/100)
#  * FALLBACK: force-closed at DELTA_STRANGLE9PM_EXIT_HOUR:MINUTE IST the next day
# Checked once per closed 1-minute trade candle, falling back to live mark
# price only for a leg with no recent trade.
#
# SIZING: same dynamic $-per-lot formula as strangle9pmbot/strangle9pmladderbot
# (floor(balance / CAPITAL_PER_LOT), capped at MAX_LOTS), divided by the
# number of TIERS (2 here, not legs) so TOTAL exposure across all 4 legs
# matches what strangle9pmbot would deploy across its 2 legs at the SAME
# real balance.
#
# If any leg fails to fill partway through entry, every leg that DID
# already fill is immediately unwound (closed) rather than left running as
# a partial, unhedged ladder.
#
# Backtested (scripts/backtest_daily_strangle_9pm_laddered.py --otm-pcts
# "1,1.5") at matched 60 TOTAL lots, 90 days -- the BEST of every variant
# compared:
#   2-leg strangle9pmbot (2% only):        +$102.80  (76.7% win, 90 strangles)
#   3-tier ladder (1%/1.5%/2%):            +$121.55  (73.3% win)
#   2-tier ladder (1.5%/2%, drop 1%):       +$85.53  (74.4% win)
#   2-tier ladder (1%/1.5%, drop 2% -- THIS ONE): +$143.02  (73.3% win)
# Dropping the 2% tier and concentrating size into the richer, nearer-the-
# money 1%/1.5% strikes outperformed every other combination tested. This
# is a brand-new engine config and has NEVER executed a real order --
# watch it closely through at least the first several entries.
DELTA_STRATEGY=strangle9pmladder
DELTA_OPTIONS_MODE=true
DELTA_OPTION_SIDE=sell

# --- Daily Laddered Strangle settings -- same entry/exit/target/SL as your
#     live strangle9pmbot config, just TWO tiers instead of three. ---
DELTA_STRANGLE9PM_ENTRY_HOUR=21
DELTA_STRANGLE9PM_ENTRY_MINUTE=0
DELTA_STRANGLE9PM_EXIT_HOUR=17
DELTA_STRANGLE9PM_EXIT_MINUTE=0
DELTA_STRANGLE9PM_LADDERED_OTM_PCTS=1,1.5
DELTA_STRANGLE9PM_TARGET_PCT=70.0
DELTA_STRANGLE9PM_SL_PCT=105.0
DELTA_STRANGLE9PM_POLL_SECONDS=30

# --- Dynamic lot sizing -- same $-per-lot ratio as live strangle9pmbot,
#     automatically divided by the number of OTM tiers (2) above. ---
DELTA_STRANGLE9PM_COMPOUND_CAPITAL=true
DELTA_STRANGLE9PM_CAPITAL_PER_LOT=2.0
# Hard safety ceiling (applied BEFORE dividing by the tier count) -- same
# value as the live strangle9pmbot's own ceiling.
DELTA_STRANGLE9PM_MAX_LOTS=1000

# --- Weekend: EMPTY = 24/7, same as strangle9pmbot. ---
DELTA_SKIP_WEEKDAYS=

# --- Sizing --------------------------------------------------------------------
# Static fallback lot size (used only if DELTA_STRANGLE9PM_COMPOUND_CAPITAL
# is ever turned off). This engine has NEVER traded live -- watch closely
# through at least the first several real entries before trusting any size.
DELTA_OPTION_CONTRACTS=15
# Same leverage as the live strangle9pmbot's current config.
DELTA_OPTION_LEVERAGE=100

# --- Self-heal: confirms all four tracked legs still exist on the exchange. ---
DELTA_POSITION_VERIFY_SECONDS=60

# --- State file (own sub-account, but keep this path distinct from any other
#     bot's -- including strangle9pmladderbot's own state files; the engine
#     derives FOUR per-leg files -- state/strangle9pmladder2_pos_ce_1.json /
#     _pe_1.json / _ce_1_5.json / _pe_1_5.json -- from this base path) ---
DELTA_STATE_FILE=state/strangle9pmladder2_pos.json

# --- Telegram (reuse the SAME token + chat ID as your other bots -- bot_label
#     tags every message so you can tell this bot's signals apart) ---
DELTA_TELEGRAM_TOKEN=same_token_as_your_other_bots
DELTA_TELEGRAM_CHAT_ID=same_chat_id_as_your_other_bots
DELTA_BOT_LABEL=STRANGLE9PMLADDER2

# --- Operational ---
DELTA_CLOSE_ON_SHUTDOWN=false
DELTA_LOG_LEVEL=INFO
