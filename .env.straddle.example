# Copy this to .env.straddle and fill in your credentials.
# This file is safe to commit; .env.straddle is gitignored.
#
# INTENDED TO RUN ON A SEPARATE DELTA SUB-ACCOUNT (its own capital/API keys),
# as an independent container parallel to the other bots. Do NOT point this
# at an account already running another bot -- separate capital means they
# can never collide on position ownership.

# --- Credentials (the SUB-ACCOUNT's own API key/secret -- NOT the main account) ---
DELTA_API_KEY=your_sub_account_api_key_here
DELTA_API_SECRET=your_sub_account_api_secret_here

# --- Exchange ---
DELTA_TESTNET=false
DELTA_REGION=india
DELTA_SYMBOL=BTCUSD

# --- Strategy: Straddle4pm -- NO BTC-price signal at all. Once per day, at
# DELTA_STRADDLE_ENTRY_HOUR:MINUTE IST (default 16:00, same-day expiry),
# BUYS a CALL and a PUT together, each near DELTA_TARGET_PREMIUM (~100). A
# classic long straddle: no directional bias, a bet that BTC makes a big
# enough move (either way) before square-off for one side to pay for both.
# UNLIKE EVERY OTHER BOT: a CE and a PE leg are ALWAYS opened SIMULTANEOUSLY
# (never independently), as genuinely independent contracts.
# HONESTY: this engine has NEVER executed a real order -- treat live results
# with real caution for the first several weeks, and start at 1 lot.
DELTA_STRATEGY=straddle
DELTA_OPTIONS_MODE=true
DELTA_OPTION_SIDE=buy
DELTA_TARGET_PREMIUM=100

# --- Exit target: a FIXED ABSOLUTE premium (NOT a %% of entry, unlike every
# other TP in this repo) -- whichever leg's premium first reaches this
# closes BOTH legs, the winner at that mark and the other at whatever it's
# currently worth. Neither leg has its own SL -- max loss per leg is capped
# at the premium paid (buying, not selling). ---
DELTA_STRADDLE_EXIT_TARGET=250
DELTA_STRADDLE_TP_POLL_SECONDS=15

# --- Entry window: the trigger fires on the first closed 5m candle each day
# whose IST time is in [ENTRY_HOUR:MINUTE, +ENTRY_GRACE_MINUTES). The grace
# window exists so a bot that was down through the exact entry bar just
# skips that day's entry instead of firing hours late. ---
DELTA_STRADDLE_ENTRY_HOUR=16
DELTA_STRADDLE_ENTRY_MINUTE=0
DELTA_STRADDLE_ENTRY_GRACE_MINUTES=15

# --- Weekend: EMPTY = 24/7. ---
DELTA_SKIP_WEEKDAYS=

# --- Day boundary / square-off. No rollover concept -- a closed leg just
# ends. ---
DELTA_SQUARE_OFF_HOUR=17
DELTA_SQUARE_OFF_MINUTE=25

# --- Warmup: this strategy has no indicator to warm up (it only tracks
# today's date), so these barely matter -- kept small. ---
DELTA_WARMUP_CANDLES=50
DELTA_WARMUP_DAYS=1

# --- Sizing --------------------------------------------------------------------
# This engine has NEVER traded live -- start at 1 lot and watch closely
# through at least a few real entries before raising this.
DELTA_OPTION_CONTRACTS=1

# --- State file (own sub-account, but keep this path distinct from any other
#     bot's). The engine derives TWO per-leg files from this one setting:
#     state/straddle_pos_call.json and state/straddle_pos_put.json. ---
DELTA_STATE_FILE=state/straddle_pos.json

# --- Telegram (reuse the SAME token + chat ID as your other bots -- bot_label
#     tags every message so you can tell this bot's signals apart) ---
DELTA_TELEGRAM_TOKEN=same_token_as_your_other_bots
DELTA_TELEGRAM_CHAT_ID=same_chat_id_as_your_other_bots
DELTA_BOT_LABEL=Straddle4pm

# --- Operational ---
DELTA_CLOSE_ON_SHUTDOWN=false
DELTA_LOG_LEVEL=INFO
# Diagnostic: log a full strategy-state snapshot on every closed 5m candle.
# Turn on to capture WHY today's entry did/didn't fire from the bot's own
# live data. Leave false unless investigating.
DELTA_STRADDLE_DEBUG_STATE=false
