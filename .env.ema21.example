# Copy this to .env.ema21 and fill in your credentials.
# This file is safe to commit; .env.ema21 is gitignored.
#
# INTENDED TO RUN ON A SEPARATE DELTA SUB-ACCOUNT (its own capital/API keys),
# as an independent container parallel to the other bots. Do NOT point this
# at an account already running another bot -- separate capital means they
# can never collide on position ownership.

# --- Credentials (the SUB-ACCOUNT's own API key/secret -- NOT the main account) ---
DELTA_API_KEY=your_sub_account_api_key_here
DELTA_API_SECRET=your_sub_account_api_secret_here

# --- Exchange ---
DELTA_TESTNET=false
DELTA_REGION=india
DELTA_SYMBOL=BTCUSD

# --- Strategy: Ema21Breakdown -- EMA(21) anchor -> wait-for-confirmation ->
# breakout pattern on 15m candles. BUYS options: bullish signal -> buy CALL,
# bearish -> buy PUT. Max loss per trade is capped at the premium paid -- no
# margin/leverage concept, unlike selling. Exits: the strategy's own SL (a
# dynamic "candle closed back through EMA21" stop, see DELTA_EMA21_EMA_SL
# below) or the daily square-off -- NO premium take-profit (see
# DELTA_TAKE_PROFIT_PCT below): winners ride uncapped to 17:25 IST instead
# of being closed early at a fixed multiple.
# 1-month backtest at 100 lots, exit-at-17:25 vs the old 300%-gain TP, same
# window: no-TP +$309.30/27 legs/55.6% WR beat with-TP +$254.35/28 legs/
# 57.1% WR by ~$55 -- the SL side is byte-for-byte identical between the
# two; the difference is entirely trades that used to cap out at the TP
# now riding further to the close. Prior 3-month with-TP baseline (25
# lots): +$90.69 net (79 legs, 44.3% WR).
# HONESTY: this is the THINNEST live/backtest history of any bot in the fleet
# and has NEVER executed a real order -- treat live results with real
# caution for the first several weeks, especially on a still-fresh no-TP
# config change.
DELTA_STRATEGY=ema21
DELTA_OPTIONS_MODE=true
DELTA_OPTION_SIDE=buy
DELTA_TARGET_PREMIUM=100
# Rally take-profit: close when the BOUGHT option's premium rises this %
# (e.g. 300 -> the option must roughly 4x, entry 100 -> TP 400). 0 = OFF --
# no premium target at all, exits only via SL or the 17:25 square-off. Note:
# a bug where 0 set the TP to the entry fill itself (closing almost
# instantly) was fixed in core/ema21_trader.py -- 0 now behaves correctly.
DELTA_TAKE_PROFIT_PCT=0

# --- Ema21Breakdown pattern settings ---
DELTA_EMA21_EMA_LEN=21
DELTA_EMA21_MAX_WAIT=3
# BTC-price 2R target -- 0 (validated config) disables it; profit comes from
# DELTA_TAKE_PROFIT_PCT (the rally TP) instead.
DELTA_EMA21_TARGET_RR=0
DELTA_EMA21_TRADE_CE=true
DELTA_EMA21_TRADE_PE=true
DELTA_EMA21_TREND_FILTER=false
DELTA_EMA21_EMA200_FILTER=false
DELTA_EMA21_EMA50_LEN=50
DELTA_EMA21_EMA200_LEN=200
# Dynamic SL: exit the moment a candle CLOSES back through EMA21, instead of
# a fixed anchor-price stop. true = the validated live config.
DELTA_EMA21_EMA_SL=true
# Only take NEW entries between 12:00 and 17:00 IST (pattern detection still
# runs at all hours; a trigger outside this window is discarded, not held).
DELTA_EMA21_ENTRY_START_HOUR=12
DELTA_EMA21_ENTRY_END_HOUR=17
# Poll the bought option's mark this often (seconds) for the rally TP. This is
# a point-in-time snapshot, not a continuous "touched" scan like the
# backtest's candle-high check, so a brief wick above target between two polls
# can be missed -- 15s is a reasonable starting point, tighten if misses show up.
DELTA_EMA21_TP_POLL_SECONDS=15

# --- Weekend: EMPTY = 24/7. The backtest never excluded weekends, so live
# starts matching that (no Sat/Sun entry block). ---
DELTA_SKIP_WEEKDAYS=

# --- Day boundary / square-off. This strategy has NO rollover concept (a
# closed setup just ends; a fresh one re-forms if conditions recur), so only
# the square-off time matters -- DELTA_ENTRY_RESUME_HOUR/MINUTE are unused. ---
DELTA_SQUARE_OFF_HOUR=17
DELTA_SQUARE_OFF_MINUTE=25

# --- Warmup (EMA21 alone needs little history; generous defaults regardless) ---
DELTA_WARMUP_CANDLES=200
DELTA_WARMUP_DAYS=3

# --- Sizing --------------------------------------------------------------------
# This engine has NEVER traded live, on the strategy with the thinnest
# backtest history in the fleet, now ALSO on a freshly-changed exit rule
# (no premium TP) -- watch closely through at least a few real entries
# after any config change like this, regardless of lot size.
DELTA_OPTION_CONTRACTS=50
# Balance-based position sizing (added on request): 0 (default) = ignore this,
# use the static DELTA_OPTION_CONTRACTS above, unchanged behavior. > 0 (e.g.
# 10 for 10%) = spend that %% of CURRENT available balance on each entry's
# premium instead -- lots are computed fresh per trade from the real selected
# contract's mark price (OptionsExecutor.open_option_by_balance_fraction), so
# position size automatically grows/shrinks with account equity. If the
# computed lot count would be 0 (balance too small for even 1 lot), the
# entry is SKIPPED entirely rather than forcing a minimum size --
# DELTA_OPTION_CONTRACTS above is then unused. NEVER tested live -- validate
# carefully (small %%, watch the first several entries) before trusting it
# unattended.
DELTA_EMA21_BALANCE_PCT=0

# --- State file (own sub-account, but keep this path distinct from any other bot's) ---
DELTA_STATE_FILE=state/ema21_pos.json

# --- Telegram (reuse the SAME token + chat ID as your other bots -- bot_label
#     tags every message so you can tell this bot's signals apart) ---
DELTA_TELEGRAM_TOKEN=same_token_as_your_other_bots
DELTA_TELEGRAM_CHAT_ID=same_chat_id_as_your_other_bots
DELTA_BOT_LABEL=EMA21

# --- Operational ---
DELTA_CLOSE_ON_SHUTDOWN=false
DELTA_LOG_LEVEL=INFO
# Diagnostic: log a full strategy-state snapshot on every closed 15m candle.
# ~96 lines/day. Turn on to capture WHY a signal did/didn't fire from the
# bot's own live data. Leave false unless investigating.
DELTA_EMA21_DEBUG_STATE=false
