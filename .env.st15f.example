# Copy this to .env.st15f and fill in your credentials.
# This file is safe to commit; .env.st15f is gitignored.
#
# INTENDED TO RUN ON A SEPARATE DELTA SUB-ACCOUNT (its own capital/API keys),
# as an independent container parallel to the other bots. Do NOT point this
# at an account already running another bot -- separate capital means they
# can never collide on position ownership.

# --- Credentials (the SUB-ACCOUNT's own API key/secret -- NOT the main account) ---
DELTA_API_KEY=your_sub_account_api_key_here
DELTA_API_SECRET=your_sub_account_api_secret_here

# --- Exchange ---
DELTA_TESTNET=false
DELTA_REGION=india
DELTA_SYMBOL=BTCUSD

# --- Strategy: Supertrend 15m-Filter Fixed-SL -- runs on 1-MINUTE candles
# (hardcoded in core/supertrend_15m_filter_fixed_sl_trader.py). STRICT SINGLE
# POSITION (like DELTA_STRATEGY=sar, unlike DELTA_STRATEGY=supertrend's
# simultaneous CE+PE). SELLS options: entry_is_short (from the strategy)
# picks the side -- true -> sell CALL (CE), false -> sell PUT (PE). Runs on
# REAL (non-HA) candles -- Heikin Ashi was only ever applied to the separate
# DELTA_STRATEGY=supertrend_flip strategy, never this one.
#
# Rules (see src/deltabot/strategy/supertrend_15m_filter_fixed_sl.py's module
# docstring for the full rule set):
#  1. A 1-minute Supertrend(10,3) fires the entry on its own FRESH flip
#     (the exact bar it changes direction), but ONLY when a 15-minute
#     Supertrend(10,3) ALREADY agrees at that same moment -- a LOCKED
#     (bucket-boundary) confirmation filter, not Pine's live-repainting
#     request.security(). No "wait for 15m to catch up" mechanic -- if the
#     15m disagrees right at the flip, that flip is simply skipped.
#  2. SL is FROZEN at the 1-minute Supertrend's own value on the flip/entry
#     candle -- a genuine BTC price level that does NOT trail. The instant
#     real price crosses it (checked at candle close), the position closes.
#     No auto-reverse (unlike DELTA_STRATEGY=sar) -- just goes flat.
#  3. Profit target (DELTA_ST15F_TARGET_PCT): an OPTION-PREMIUM mechanic
#     checked ONCE PER CLOSED 1-MINUTE CANDLE (not a continuous poll, to
#     exactly match the validated backtest). REDUCTION convention -- "target
#     70% reduce price of option means if sold at 100 then target is 30",
#     i.e. target = entry_premium * (1 - DELTA_ST15F_TARGET_PCT/100). This is
#     the OPPOSITE convention from DELTA_SAR_TP_PCT's decay-TO target -- do
#     not copy one bot's number to the other without converting it. After a
#     target hit, NO new trade until the 15-minute Supertrend itself has its
#     own next fresh flip (in either direction).
#  4. NO daily square-off, NO rollover -- neither was described and the
#     validated backtest has neither. A still-open leg just runs until its
#     own SL/target fires, or (live-only) the exchange's own settlement plus
#     this bot's regular self-heal/reconcile catches an expired contract and
#     force-flattens.
#  5. Expiry needed MINUTE precision ("if at 17:26 you should take trade in
#     next day option") -- DELTA_ST15F_EXPIRY_CUTOFF_HOUR/MINUTE (17:26 IST
#     default), NOT the shared DELTA_OPTION_EXPIRY_CUTOFF_HOUR (hour-only,
#     unused by this bot).
#
# Best validated backtest (1m, 15m filter, frozen SL, target 70%, premium
# ~1400, 25 lots): 1wk +$32.67/38 legs/26.3% win, 1mo +$243.25/150 legs/30.0%
# win, 3mo +$635.26/483 legs/28.8% win -- the most consistent pace (~5.4
# legs/day) and win rate across all three windows of any strategy tested
# this session.
# HONESTY: this engine has NEVER executed a real order -- watch it closely.
DELTA_STRATEGY=st15f
DELTA_OPTIONS_MODE=true
DELTA_OPTION_SIDE=sell
DELTA_TARGET_PREMIUM=1400

# --- Supertrend 15m-Filter settings ---
DELTA_ST15F_ATR_PERIOD=10
DELTA_ST15F_FACTOR=3.0
DELTA_ST15F_ATR_PERIOD_15M=10
DELTA_ST15F_FACTOR_15M=3.0
# Minute-precise next-day expiry cutoff -- see rule 5 above.
DELTA_ST15F_EXPIRY_CUTOFF_HOUR=17
DELTA_ST15F_EXPIRY_CUTOFF_MINUTE=26
# Profit target, REDUCTION convention -- see rule 3 above. 0 = no target at
# all (SL/self-heal are then the only exits).
DELTA_ST15F_TARGET_PCT=70.0

# --- Weekend: EMPTY = 24/7. The backtest never excluded weekends, so live
# starts matching that (no Sat/Sun entry block). Exits always still run. ---
DELTA_SKIP_WEEKDAYS=

# --- Warmup (needs enough 1m bars for both the 1m ATR AND enough completed
# 15m buckets for the 15m ATR -- the engine takes the larger of the two
# floors automatically; these are just generous starting points) ---
DELTA_WARMUP_CANDLES=200
DELTA_WARMUP_DAYS=3

# --- Sizing --------------------------------------------------------------------
# This engine has NEVER traded live -- watch closely through at least a few
# real entries before trusting this size.
DELTA_OPTION_CONTRACTS=10
# Sets leverage on the option product right before selling (sell-side only,
# which this bot always is). Higher leverage locks less margin per lot but
# moves the liquidation price much closer to entry; the strategy's own SL is
# still what's expected to close the trade first. 0 = leave exchange
# default. 50 matches every other live bot on this account.
DELTA_OPTION_LEVERAGE=50

# --- Self-heal: also the ONLY thing that notices an expired/externally-
# closed contract on this bot (no bespoke expiry-force-close, unlike the
# backtest -- see rule 4 above). ---
DELTA_POSITION_VERIFY_SECONDS=60

# --- State file (own sub-account, but keep this path distinct from any other bot's) ---
DELTA_STATE_FILE=state/st15f_pos.json

# --- Telegram (reuse the SAME token + chat ID as your other bots -- bot_label
#     tags every message so you can tell this bot's signals apart) ---
DELTA_TELEGRAM_TOKEN=same_token_as_your_other_bots
DELTA_TELEGRAM_CHAT_ID=same_chat_id_as_your_other_bots
DELTA_BOT_LABEL=ST15F

# --- Operational ---
DELTA_CLOSE_ON_SHUTDOWN=false
DELTA_LOG_LEVEL=INFO
# Diagnostic: log a full strategy-state snapshot on every closed 1m candle.
# ~1440 lines/day. Turn on to capture WHY a signal did/didn't fire from the
# bot's own live data. Leave false unless investigating.
DELTA_ST15F_DEBUG_STATE=false
