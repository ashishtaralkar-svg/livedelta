# Copy this to .env.sar and fill in your credentials.
# This file is safe to commit; .env.sar is gitignored.
#
# INTENDED TO RUN ON A SEPARATE DELTA SUB-ACCOUNT (its own capital/API keys),
# as an independent container parallel to the other bots. Do NOT point this
# at an account already running another bot -- separate capital means they
# can never collide on position ownership.

# --- Credentials (the SUB-ACCOUNT's own API key/secret -- NOT the main account) ---
DELTA_API_KEY=your_sub_account_api_key_here
DELTA_API_SECRET=your_sub_account_api_secret_here

# --- Exchange ---
DELTA_TESTNET=false
DELTA_REGION=india
DELTA_SYMBOL=BTCUSD

# --- Strategy: Supertrend Stop-And-Reverse (SAR) -- runs on 1-MINUTE
# Supertrend(10,3) candles (hardcoded in core/supertrend_sar_trader.py).
# STRICT SINGLE POSITION (unlike DELTA_STRATEGY=supertrend, never CE+PE at
# once). SELLS options: entry_is_short (from the strategy) picks the side --
# true -> sell CALL (CE), false -> sell PUT (PE).
#
# Rules (see src/deltabot/strategy/supertrend_sar.py's module docstring for
# the full v1-v5 history):
#  1. Session's first entry: the candle that CLOSES at
#     DELTA_SAR_START_HOUR:MINUTE (17:35 IST default) arms a position by its
#     OWN COLOR -- red -> sell CE, green -> sell PE. Supertrend is NOT
#     consulted for direction, only for this entry's SL (its value at that
#     moment, frozen). 17:35 sits right next to the evening-restart trigger
#     below (17:30) -- deliberately: this collapses the "day's first entry"
#     and "evening restart" into essentially one entry window, see the
#     comparison note below.
#  2. Stop-and-reverse: the instant the frozen SL is touched, that leg
#     closes AND the opposite side opens immediately -- SL = the running
#     day-low (into a long) / day-high (into a short), widened to at least
#     DELTA_SAR_MIN_SL_ATR_MULT * ATR if that would otherwise be tighter
#     (fixes same-session whipsaw right after a reset).
#  3. TP-roll (DELTA_SAR_TP_PCT): once the SOLD premium decays to this % of
#     what it was sold for, book the profit and IMMEDIATELY resell a fresh
#     contract in the SAME direction at DELTA_TARGET_PREMIUM again -- purely
#     an option-level mechanic, invisible to the strategy's own SL/session
#     state.
#  4. Evening restart (DELTA_SAR_RESTART_HOUR/MINUTE, 17:30 IST default):
#     once the daily square-off leaves the strategy flat, resume trading
#     immediately in the SAME direction as whatever was open going into it,
#     instead of waiting for next session's first entry. Because entries
#     only act on CLOSED candles, this actually lands on the candle that
#     closes just after the threshold (typically 17:31-17:32 on 1m bars).
#  5. Daily square-off at DELTA_SQUARE_OFF_HOUR:MINUTE (17:25 IST default)
#     force-closes whatever's open. No in-strategy profit target beyond the
#     TP-roll above.
#
# THE CONFIG BELOW is the FINAL/DEPLOYED one, chosen after comparing
# several candidates head-to-head on matched 1wk/1mo/3mo backtest windows
# (10 lots each, $ = net at 10 lots):
#                                    1wk       1mo        3mo      3mo $/lot/mo
#   5m, 05:35, TP 50% (original)   $18.98    $155.29   $150.22 (48.8% win)  $5.01
#   1m, 17:35, TP 70%, reset 05:30 $73.21    $183.38   $331.42 (55.7% win) $11.05
#   .. + ORB entry (v7, tried)     $60.98       --         --       (worse, reverted)
#   .. + reset moved to 17:30 (v8) $24.04     $90.81    $298.94 (47.6% win) (worse, reverted)
#   .. + weekend blackout (FINAL)  $73.59    $183.60   $363.25 (58.3% win) $12.11
# The reset-to-17:30 change fixed a real bug (a reversal's day-high/day-low
# SL could reflect a price spike from early that same morning, unrelated to
# the evening session it was trading in) but backtested WORSE on every
# window re-tested -- reverted back to the original 05:30 for that reason;
# see src/deltabot/config.py's sar_reset_hour comment for the full story.
# Weekend blackout (Fri 17:35 IST -> Sun 17:35 IST, fresh entries only) was
# a strict improvement with no downside and is now on by default. Two
# caveats worth knowing regardless: (a) DELTA_SAR_MIN_SL_ATR_MULT=1.0 was
# tuned on 5m candles and never independently re-tuned for 1m's much
# smaller/noisier ATR(10) -- carried forward because the COMBINATION
# backtested better, not because 1.0 was re-derived for 1m; (b) all
# backtest windows above overlap (drawn from the same recent months, not
# independent market periods).
# HONESTY: this engine has NEVER executed a real order -- watch it closely.
DELTA_STRATEGY=sar
DELTA_OPTIONS_MODE=true
DELTA_OPTION_SIDE=sell
DELTA_TARGET_PREMIUM=1400

# --- Supertrend SAR settings ---
DELTA_SAR_ATR_PERIOD=10
DELTA_SAR_FACTOR=3.0
DELTA_SAR_START_HOUR=17
DELTA_SAR_START_MINUTE=35
# Session (not calendar-day) reset -- day-high/day-low and the "first entry
# already fired" flag all roll over here. Deliberately NOT moved alongside
# the start time above -- kept at 05:30 so a reversal's day-low/day-high SL
# has the whole prior session's range behind it by the time entries start
# at 17:35.
DELTA_SAR_RESET_HOUR=5
DELTA_SAR_RESET_MINUTE=30
# Widen a reversal's day-low/day-high SL to at least this many ATRs from
# price if it would otherwise be tighter. 0 disables (raw day-extreme SL,
# which backtested worse -- more, tighter, same-session whipsaw reversals).
DELTA_SAR_MIN_SL_ATR_MULT=1.0
# Evening restart: see rule 4 above.
DELTA_SAR_RESTART_HOUR=17
DELTA_SAR_RESTART_MINUTE=30
# TP-roll target: 70% (book profit on a 30% decay) beat the original 50% on
# every window tested, see the comparison table above. 0 disables entirely
# (pure SAR, no rolling).
DELTA_SAR_TP_PCT=70.0
# Poll the sold option's mark this often (seconds) for the TP-roll. Point-in-
# time snapshot, not a continuous "touched" scan like the backtest's candle
# check, so a brief wick through the target between two polls can be missed.
DELTA_SAR_TP_POLL_SECONDS=15

# --- Weekend: DELTA_SKIP_WEEKDAYS is a full-day-of-week skip (EMPTY =
# none) -- left empty here since the SAR blackout below already covers the
# weekend more precisely. DELTA_SAR_WEEKEND_BLACKOUT blocks FRESH entries
# (day's-first-entry / evening-restart) from Fri 17:35 IST through Sun
# 17:35 IST -- backtested as a strict improvement with no downside (see
# the comparison table above). Neither setting ever blocks a same-bar
# stop-and-reverse or a TP-roll re-entry, since both just manage
# already-open risk rather than opening fresh exposure. ---
DELTA_SKIP_WEEKDAYS=
DELTA_SAR_WEEKEND_BLACKOUT=true

# --- Day boundary / square-off ---
DELTA_SQUARE_OFF_HOUR=17
DELTA_SQUARE_OFF_MINUTE=25

# --- Warmup ---
DELTA_WARMUP_CANDLES=200
DELTA_WARMUP_DAYS=3

# --- Sizing --------------------------------------------------------------------
# This engine has NEVER traded live -- watch closely through at least a few
# real entries before assuming this size is safe.
DELTA_OPTION_CONTRACTS=10
# Sets leverage on the option product right before selling (sell-side only,
# which SAR always is -- a no-op on buy-mode bots). Higher leverage locks less
# margin per lot but moves the liquidation price much closer to entry; the
# strategy's own SL is still what's expected to close the trade first. 0 =
# leave exchange default. 50 matches every other live bot on this account.
DELTA_OPTION_LEVERAGE=50

# --- State file (own sub-account, but keep this path distinct from any other bot's) ---
DELTA_STATE_FILE=state/sar_pos.json

# --- Telegram (reuse the SAME token + chat ID as your other bots -- bot_label
#     tags every message so you can tell this bot's signals apart) ---
DELTA_TELEGRAM_TOKEN=same_token_as_your_other_bots
DELTA_TELEGRAM_CHAT_ID=same_chat_id_as_your_other_bots
DELTA_BOT_LABEL=SAR

# --- Operational ---
DELTA_CLOSE_ON_SHUTDOWN=false
DELTA_LOG_LEVEL=INFO
# Diagnostic: log a full strategy-state snapshot on every closed 1m candle.
# ~1440 lines/day -- much chattier than a 5m bot's equivalent setting. Turn
# on to capture WHY a signal did/didn't fire from the bot's own live data.
# Leave false unless investigating.
DELTA_SAR_DEBUG_STATE=false
