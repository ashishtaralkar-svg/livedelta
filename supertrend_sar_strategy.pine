//@version=5
// ============================================================================
// SUPERTREND STOP-AND-REVERSE (SAR) v10 -- FINAL/DEPLOYED config, ported
// directly from src/deltabot/strategy/supertrend_sar.py (v9) plus the
// weekend blackout the live engine layers on top (config.py's
// sar_weekend_blackout). This replaces v3 below, which predates the
// evening-restart, min-SL-ATR guard, and weekend-blackout features and was
// never kept in sync with the Python side as those were added.
//
// v1: reversal SL = a fresh Supertrend read at the reversal moment; session
//     reset = calendar-day (IST midnight). Produced zero trades in
//     TradingView.
// v2: reversal SL = the running day-low/day-high instead; session reset =
//     a custom 05:30 IST boundary instead of midnight.
// v3: the day's FIRST entry's direction stopped reading Supertrend at all --
//     it reads the closing candle's own color instead (Supertrend is still
//     used for THIS entry's SL, just not its direction).
// v4 (this version): a MINIMUM SL DISTANCE guard on reversals (minSlAtrMult)
//     -- real backtest logs showed repeated same-session whipsaw right
//     after a session reset, when day-high/day-low is still only a few
//     bars wide and sits too close to price to be a meaningful stop.
// v5 (this version): EVENING RESTART -- previously the strategy sat flat
//     from square-off (17:25 IST) until next session's first entry
//     (17:35 IST by default); now it resumes, in the SAME direction as
//     whatever was open going into square-off, at restartHr:restartMin
//     (default 17:30 IST, 5 minutes after the usual 17:25 square-off)
//     instead of waiting. Because restartMins (17:30) sits just before
//     startMins (17:35), restart normally claims the day's trading window
//     every session once anything has ever closed once -- the candle-color
//     first-entry branch below then only actually fires on the very first
//     session a fresh strategy instance ever sees (nothing to restart
//     from yet). This is deliberate, not a bug -- see the matching note in
//     supertrend_sar.py's own module docstring.
// v10 (this version): WEEKEND BLACKOUT -- blocks FRESH entries (the day's
//     first entry, or the evening restart) from Fri 17:35 IST through Sun
//     17:35 IST. A same-bar stop-and-reverse is NEVER blocked by this,
//     since it's just closing out already-open risk, not opening new
//     exposure -- exactly mirroring DELTA_SAR_WEEKEND_BLACKOUT in the live
//     Python engine. Backtested (10 lots, 3 months) as a strict
//     improvement with no downside: +$363.25/441 legs/58.3% win vs
//     +$331.42/492 legs/55.7% win without it.
//
// TP-ROLL DELIBERATELY NOT INCLUDED: the live/backtest engine also books
// profit and IMMEDIATELY re-sells the same direction once the SOLD
// OPTION's premium decays to 70% of what it was sold for
// (DELTA_SAR_TP_PCT). That is a pure OPTION-PREMIUM mechanic, not a BTC-
// price one -- this chart only ever sees the underlying, so there is no
// faithful way to show it here without silently guessing at how the
// option's premium moves relative to price (which varies with strike,
// time-to-expiry, and IV, none of which this chart has). Everything else
// below -- entry, frozen SL, reversal, the ATR-distance guard, evening
// restart, square-off, and the weekend blackout -- is pure BTC-price logic
// and is reproduced exactly, matching the deployed engine's rules.
//
// "Session" here means a custom trading window that resets at
// resetHr:resetMin IST (default 05:30), not the calendar day -- day-high,
// day-low, and the "this session's first-entry/restart slot has already
// been used" flags all roll over together the instant the clock crosses
// that boundary. A session's first-entry slot (and separately, its restart
// slot) is marked USED the instant its time window is reached, whether or
// not the weekend blackout actually let it place an order that bar -- so a
// blacked-out slot does not just retry again next bar; it waits for its
// own window next session, exactly like the deployed engine.
// ============================================================================
strategy("Supertrend SAR v10 (final)", overlay=true, pyramiding=0, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, process_orders_on_close=true, calc_on_every_tick=false, commission_type=strategy.commission.percent, commission_value=0.0, max_labels_count=500)

// ------------------------------------------------------------------
// Inputs
// ------------------------------------------------------------------
grpST = "Supertrend"
atrPeriod    = input.int(10, "ATR Period", minval=1, group=grpST)
factor       = input.float(3.0, "Multiplier", minval=0.1, group=grpST)
minSlAtrMult = input.float(1.0, "Min SL distance (x ATR)", minval=0.0, group=grpST, tooltip="Widen a reversal's day-low/day-high SL to at least this many ATRs from price if it would otherwise be tighter (fixes same-session whipsaw right after a session reset). 0 disables.")

grpSession = "Session times (IST)"
dayTZ      = input.string("Asia/Kolkata", "Timezone", group=grpSession)
startHr    = input.int(17, "First-entry Hour",       minval=0, maxval=23, group=grpSession)
startMin   = input.int(35, "First-entry Minute",     minval=0, maxval=59, group=grpSession)
resetHr    = input.int(5,  "Session Reset Hour",     minval=0, maxval=23, group=grpSession)
resetMin   = input.int(30, "Session Reset Minute",   minval=0, maxval=59, group=grpSession)
restartHr  = input.int(17, "Evening Restart Hour",   minval=0, maxval=23, group=grpSession)
restartMin = input.int(30, "Evening Restart Minute", minval=0, maxval=59, group=grpSession)
sqHr       = input.int(17, "Square-off Hour",        minval=0, maxval=23, group=grpSession)
sqMin      = input.int(25, "Square-off Minute",      minval=0, maxval=59, group=grpSession)

grpWk     = "Weekend blackout"
wkEnabled = input.bool(true, "Block fresh entries Fri 17:35 -> Sun 17:35 IST", group=grpWk)

// ------------------------------------------------------------------
// Supertrend(10,3) on real (non-HA) OHLC -- computed continuously, same as
// the Python strategy (it needs uninterrupted history for its own ATR).
// ------------------------------------------------------------------
[st, dir] = ta.supertrend(factor, atrPeriod)
atrVal = ta.atr(atrPeriod)
plot(st, "Supertrend", color = dir < 0 ? color.new(color.green, 0) : color.new(color.red, 0), linewidth=2)

// ------------------------------------------------------------------
// Time windows -- proven hour()/minute()+timezone pattern from every other
// script in this repo.
// ------------------------------------------------------------------
startMins   = startHr * 60 + startMin
resetMins   = resetHr * 60 + resetMin
restartMins = restartHr * 60 + restartMin
sqMins      = sqHr * 60 + sqMin
nowMins     = hour(time, dayTZ) * 60 + minute(time, dayTZ)

squareOffNow    = not na(nowMins[1]) and nowMins >= sqMins    and nowMins[1] < sqMins
sessionRollover = not na(nowMins[1]) and nowMins >= resetMins and nowMins[1] < resetMins

var int sessionId = 0
if sessionRollover
    sessionId := sessionId + 1

// Running day-high / day-low: resets the instant the session boundary is
// crossed, then simply expands with each bar's high/low through the rest
// of the session.
var float dHigh = na
var float dLow  = na
if sessionRollover or na(dHigh)
    dHigh := high
    dLow  := low
else
    dHigh := math.max(dHigh, high)
    dLow  := math.min(dLow, low)

// ------------------------------------------------------------------
// Weekend blackout: Friday 17:35 IST through Sunday 17:35 IST (a rolling
// ~48h block, not just "skip Sat/Sun"). Only ever consulted for a FRESH
// entry below -- a same-bar reversal is never gated by it.
// ------------------------------------------------------------------
dow = dayofweek(time, dayTZ)
blackoutMins = 17 * 60 + 35
inBlackout = wkEnabled and (
     (dow == dayofweek.friday and nowMins >= blackoutMins) or
     dow == dayofweek.saturday or
     (dow == dayofweek.sunday and nowMins < blackoutMins))

// ------------------------------------------------------------------
// State
// ------------------------------------------------------------------
var float activeSL           = na   // the open leg's frozen SL (BTC price level)
var int   activeDaySession   = na   // session id whose candle-color first-entry slot has been used
var int   activeRestartSession = na // session id whose evening-restart slot has been used
var bool  lastClosedWasShort = na   // side of whichever leg most recently closed -- feeds the restart

sellFired      = false
buyFired       = false
reverseFired   = false
restartFired   = false
squareOffFired = false
blockedFired   = false

// ----- 1. Frozen SL touched -> reverse immediately. New SL = day-low (into
//          a long) / day-high (into a short), widened to at least
//          minSlAtrMult * ATR from price if that would otherwise be
//          tighter. NEVER gated by the weekend blackout -- this is closing
//          out already-open risk, not opening new exposure. -----
shortSlHit = strategy.position_size < 0 and not na(activeSL) and high >= activeSL
longSlHit  = strategy.position_size > 0 and not na(activeSL) and low  <= activeSL

if shortSlHit or longSlHit
    lastClosedWasShort := shortSlHit
    newIsShort = not shortSlHit
    rawSl = newIsShort ? dHigh : dLow
    guardedSl = rawSl
    if minSlAtrMult > 0 and not na(atrVal)
        minDist = atrVal * minSlAtrMult
        guardedSl := newIsShort ? math.max(rawSl, close + minDist) : math.min(rawSl, close - minDist)
    activeSL := guardedSl
    if newIsShort
        strategy.entry("Short", strategy.short, comment="reverse: dayHigh+ATRguard")
        sellFired := true
    else
        strategy.entry("Long", strategy.long, comment="reverse: dayLow-ATRguard")
        buyFired := true
    reverseFired := true

// ----- 2. Daily square-off: force flat unconditionally, even a leg that
//          just opened via the reversal above on this SAME bar. Remembers
//          which side was open going into it, for the evening restart. -----
if squareOffNow and strategy.position_size != 0
    lastClosedWasShort := strategy.position_size < 0
    strategy.close_all(comment="EOD square-off")
    activeSL := na
    squareOffFired := true

// ----- 3. Day's first entry (candle-color) OR evening restart -- at most
//          ONE fresh entry per bar, only while flat. The day's-first-entry
//          slot is checked first; the restart slot only if that one isn't
//          due yet this session (mirrors the Python elif ordering exactly
//          -- since restartMins sits before startMins by default, restart
//          normally claims the window every session once anything has
//          ever closed once). Both slots are marked USED the instant their
//          window is reached, blacked out or not, so a block doesn't just
//          retry next bar. -----
flatNow = strategy.position_size == 0
if flatNow and not squareOffNow
    if sessionId != activeDaySession and nowMins >= startMins
        activeDaySession := sessionId
        if inBlackout
            blockedFired := true
        else if close < open
            strategy.entry("Short", strategy.short)   // red candle -> SELL (CE); SL from Supertrend
            activeSL := st
            sellFired := true
        else
            strategy.entry("Long", strategy.long)     // green candle -> BUY (PE); SL from Supertrend
            activeSL := st
            buyFired := true
    else if not na(lastClosedWasShort) and sessionId != activeRestartSession and nowMins >= restartMins
        activeRestartSession := sessionId
        if inBlackout
            blockedFired := true
        else
            activeSL := st
            if lastClosedWasShort
                strategy.entry("Short", strategy.short, comment="evening restart")
                sellFired := true
            else
                strategy.entry("Long", strategy.long, comment="evening restart")
                buyFired := true
            restartFired := true

// ------------------------------------------------------------------
// Plotting / markers
// ------------------------------------------------------------------
bgcolor(squareOffNow ? color.new(color.gray, 85) : na, title="Square-off moment")
bgcolor(inBlackout ? color.new(color.purple, 90) : na, title="Weekend blackout window")

plotshape(sellFired, title="SELL marker", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
plotshape(buyFired, title="BUY marker", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.small)
plotshape(reverseFired, title="Stop-and-reverse marker", style=shape.xcross, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny)
plotshape(restartFired, title="Evening restart marker", style=shape.diamond, location=location.belowbar, color=color.new(color.blue, 0), size=size.tiny)
plotshape(squareOffFired, title="Square-off exit marker", style=shape.square, location=location.abovebar, color=color.new(color.gray, 0), size=size.tiny)
plotshape(blockedFired, title="Blocked-by-blackout marker", style=shape.circle, location=location.abovebar, color=color.new(color.purple, 0), size=size.tiny)

if sellFired
    label.new(bar_index, high, text="SELL", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.normal)
if buyFired
    label.new(bar_index, low, text="BUY", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.normal)
if restartFired
    label.new(bar_index, high, text="RESTART", style=label.style_label_down, color=color.new(color.blue, 0), textcolor=color.white, size=size.small)
if squareOffFired
    label.new(bar_index, high, text="EOD", style=label.style_label_down, color=color.new(color.gray, 0), textcolor=color.white, size=size.small)
if blockedFired
    label.new(bar_index, high, text="BLOCKED", style=label.style_label_down, color=color.new(color.purple, 0), textcolor=color.white, size=size.small)

inPos = strategy.position_size != 0
plot(inPos ? activeSL : na, "Active (frozen) SL", color=color.orange, style=plot.style_linebr, linewidth=2)
plot(inPos ? strategy.position_avg_price : na, "Entry", color=color.gray, style=plot.style_linebr, linewidth=1)
plot(dHigh, "Session High", color=color.new(color.silver, 60), style=plot.style_circles)
plot(dLow,  "Session Low",  color=color.new(color.silver, 60), style=plot.style_circles)
