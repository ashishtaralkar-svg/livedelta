# Copy this to .env.strangle9pm and fill in your credentials.
# This file is safe to commit; .env.strangle9pm is gitignored.
#
# INTENDED TO RUN ON A SEPARATE DELTA SUB-ACCOUNT (its own capital/API keys),
# as an independent container parallel to the other bots. Do NOT point this
# at an account already running another bot -- separate capital means they
# can never collide on position ownership.

# --- Credentials (the SUB-ACCOUNT's own API key/secret -- NOT the main account) ---
DELTA_API_KEY=your_sub_account_api_key_here
DELTA_API_SECRET=your_sub_account_api_secret_here

# --- Exchange ---
DELTA_TESTNET=false
DELTA_REGION=india
DELTA_SYMBOL=BTCUSD

# --- Strategy: Daily 9PM IST Short Strangle -- pure TIME-based, NO BTC candle
# signal at all (unlike every other bot in this fleet). Once a day at
# DELTA_STRANGLE9PM_ENTRY_HOUR:MINUTE IST (21:00 default), SELLS a CALL and a
# PUT SIMULTANEOUSLY, each at the listed strike closest to
# DELTA_STRANGLE9PM_OTM_PCT%% OTM from the current BTC spot price (2% default
# -- CALL strike above spot, PUT strike below spot).
#
# Both legs are ALWAYS opened together and ALWAYS closed together as ONE
# combined position (unlike DELTA_STRATEGY=supertrend, whose CE/PE legs are
# genuinely independent) -- target/SL are evaluated on the SUM of both legs'
# current buyback premium against the SUM of both legs' entry premium:
#  * TARGET: combined premium decayed to <= entry * (1 - DELTA_STRANGLE9PM_TARGET_PCT/100)
#            (REDUCTION convention -- 70% default means combined premium fell to 30% of entry)
#  * SL:     combined premium rose to >= entry * (1 + DELTA_STRANGLE9PM_SL_PCT/100)
#            (RISE convention -- 50% default means combined premium rose 50% above entry)
#  * FALLBACK: if NEITHER fires, force-closed at
#            DELTA_STRANGLE9PM_EXIT_HOUR:MINUTE IST the NEXT day (17:00 default)
# Checked every DELTA_STRANGLE9PM_POLL_SECONDS via the live mark price of
# both legs (this is a premium mechanic, not something a candle feed reports).
#
# If the PUT leg fails to fill after the CALL leg already did, the CALL leg
# is immediately unwound (closed) rather than left running naked -- see the
# engine's own module docstring (src/deltabot/core/daily_strangle_9pm_trader.py).
#
# Backtested (scripts/backtest_daily_strangle_9pm.py), 10 lots, ~2% OTM,
# target 70% / SL 50%: 1wk +$21.09 (win 76.2%), 1mo +$21.09/22 strangles
# (win 76.2%) -- consistent across separate windows tested, 3mo also
# positive. This is a brand-new engine and has NEVER executed a real order --
# watch it closely through at least the first several entries.
DELTA_STRATEGY=strangle9pm
DELTA_OPTIONS_MODE=true
DELTA_OPTION_SIDE=sell

# --- Daily Strangle settings ---
DELTA_STRANGLE9PM_ENTRY_HOUR=21
DELTA_STRANGLE9PM_ENTRY_MINUTE=0
DELTA_STRANGLE9PM_EXIT_HOUR=17
DELTA_STRANGLE9PM_EXIT_MINUTE=0
DELTA_STRANGLE9PM_OTM_PCT=2.0
DELTA_STRANGLE9PM_TARGET_PCT=70.0
DELTA_STRANGLE9PM_SL_PCT=50.0
DELTA_STRANGLE9PM_POLL_SECONDS=30

# --- Weekend: EMPTY = 24/7. The backtest never excluded weekends. ---
DELTA_SKIP_WEEKDAYS=

# --- Sizing --------------------------------------------------------------------
# Requested lot size for this deployment. This engine has NEVER traded live --
# watch closely through at least the first several real entries before
# trusting this size.
DELTA_OPTION_CONTRACTS=20
# Sets leverage on the option product right before selling. Higher leverage
# locks less margin per lot but moves the liquidation price much closer to
# entry. 0 = leave exchange default. 50 matches every other live bot on this
# account.
DELTA_OPTION_LEVERAGE=50

# --- Self-heal: confirms both tracked legs still exist on the exchange. ---
DELTA_POSITION_VERIFY_SECONDS=60

# --- State file (own sub-account, but keep this path distinct from any other bot's;
#     the engine derives two per-leg files -- state/strangle9pm_pos_ce.json /
#     _pe.json -- from this base path) ---
DELTA_STATE_FILE=state/strangle9pm_pos.json

# --- Telegram (reuse the SAME token + chat ID as your other bots -- bot_label
#     tags every message so you can tell this bot's signals apart) ---
DELTA_TELEGRAM_TOKEN=same_token_as_your_other_bots
DELTA_TELEGRAM_CHAT_ID=same_chat_id_as_your_other_bots
DELTA_BOT_LABEL=STRANGLE9PM

# --- Operational ---
DELTA_CLOSE_ON_SHUTDOWN=false
DELTA_LOG_LEVEL=INFO
