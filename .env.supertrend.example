# Copy this to .env.supertrend and fill in your credentials.
# This file is safe to commit; .env.supertrend is gitignored.
#
# INTENDED TO RUN ON A SEPARATE DELTA SUB-ACCOUNT (its own capital/API keys),
# as an independent container parallel to the other bots. Do NOT point this
# at an account already running another bot -- separate capital means they
# can never collide on position ownership.

# --- Credentials (the SUB-ACCOUNT's own API key/secret -- NOT the main account) ---
DELTA_API_KEY=your_sub_account_api_key_here
DELTA_API_SECRET=your_sub_account_api_secret_here

# --- Exchange ---
DELTA_TESTNET=false
DELTA_REGION=india
DELTA_SYMBOL=BTCUSD

# --- Strategy: SupertrendFixedSl -- Supertrend(10,3) flip timing on 5m real
# (non-HA) candles. SELLS options: bearish flip -> sell CALL, bullish flip ->
# sell PUT. SL = Supertrend's own value AT THE FLIP, frozen for the life of
# that leg -- never re-derived from Supertrend's still-updating value. NO
# profit target at all -- the only exits are that frozen SL or the daily
# square-off.
# UNLIKE EVERY OTHER BOT: a CE and a PE leg can be open SIMULTANEOUSLY, as
# genuinely independent contracts (not mutually exclusive).
# Best backtest (5m, sell, premium~1400, 25 lots, 1 WEEK): +$65.56 net (27
# legs, 29.6% WR) -- most of the profit comes from letting winners ride to
# the 17:25 square-off rather than any target, since there isn't one.
# HONESTY: this engine has NEVER executed a real order -- treat live results
# with real caution for the first several weeks.
DELTA_STRATEGY=supertrend
DELTA_OPTIONS_MODE=true
DELTA_OPTION_SIDE=sell
DELTA_TARGET_PREMIUM=1400

# --- SupertrendFixedSl pattern settings ---
DELTA_SUPERTREND_ATR_PERIOD=10
DELTA_SUPERTREND_FACTOR=3.0
DELTA_SUPERTREND_TRADE_CE=true
DELTA_SUPERTREND_TRADE_PE=true

# --- Settlement gap (blocks NEW entries only, both legs) ---
DELTA_SUPERTREND_GAP_START_HOUR=17
DELTA_SUPERTREND_GAP_START_MINUTE=25
DELTA_SUPERTREND_GAP_END_HOUR=17
DELTA_SUPERTREND_GAP_END_MINUTE=30

# --- Weekend: EMPTY = 24/7. The backtest never excluded weekends, so live
# starts matching that (no Sat/Sun entry block). ---
DELTA_SKIP_WEEKDAYS=

# --- Day boundary / square-off. No rollover concept -- a closed leg just
# ends; a fresh flip re-arms from scratch. ---
DELTA_SQUARE_OFF_HOUR=17
DELTA_SQUARE_OFF_MINUTE=25

# --- Warmup (ATR(10) needs little history; generous defaults regardless) ---
DELTA_WARMUP_CANDLES=200
DELTA_WARMUP_DAYS=3

# --- Sizing --------------------------------------------------------------------
# This engine has NEVER traded live -- watch the first several entries/exits
# closely (Telegram + docker logs) before trusting it unattended, especially
# since it can hold TWO legs at once.
DELTA_OPTION_CONTRACTS=10
# Sets leverage on the option product right before selling (sell-side only --
# a no-op on buy-mode bots). Higher leverage locks less margin per lot but
# moves the liquidation price much closer to entry; the strategy's own SL is
# still what's expected to close the trade first. 0 = leave exchange default.
DELTA_OPTION_LEVERAGE=50

# --- State file (own sub-account, but keep this path distinct from any other
#     bot's). The engine derives TWO per-leg files from this one setting:
#     state/supertrend_pos_short.json (CE) and state/supertrend_pos_long.json (PE). ---
DELTA_STATE_FILE=state/supertrend_pos.json

# --- Telegram (reuse the SAME token + chat ID as your other bots -- bot_label
#     tags every message so you can tell this bot's signals apart) ---
DELTA_TELEGRAM_TOKEN=same_token_as_your_other_bots
DELTA_TELEGRAM_CHAT_ID=same_chat_id_as_your_other_bots
DELTA_BOT_LABEL=Supertrend

# --- Operational ---
DELTA_CLOSE_ON_SHUTDOWN=false
DELTA_LOG_LEVEL=INFO
# Diagnostic: log a full strategy-state snapshot on every closed 5m candle.
# Turn on to capture WHY a signal did/didn't fire from the bot's own live
# data. Leave false unless investigating.
DELTA_SUPERTREND_DEBUG_STATE=false
