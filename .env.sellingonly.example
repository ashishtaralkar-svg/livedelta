# Copy this to .env.sellingonly and fill in your credentials.
# This file is safe to commit; .env.sellingonly is gitignored.
#
# INTENDED TO RUN ON A SEPARATE DELTA SUB-ACCOUNT (its own capital/API keys),
# as an independent container parallel to the other bots. Do NOT point this
# at an account already running another bot -- separate capital means they
# can never collide on position ownership.
#
# This is the SAME underlying engine as .env.supertrend.example (strategy=
# supertrend, src/deltabot/core/supertrend_trader.py) -- "Selling Only" is
# just this particular configuration of it: TRAILING SL instead of frozen,
# no trend filter, no premium-decay TP. Supertrend(10,3) flip timing SELLS
# a CALL on a bearish flip, a PUT on a bullish flip, near DELTA_TARGET_PREMIUM
# (1000). A CE and a PE leg can be open SIMULTANEOUSLY, as genuinely
# independent contracts (see supertrend_fixed_sl.py's own docstring).
# HONESTY: this engine has NEVER executed a real order -- treat live results
# with real caution for the first several weeks.

# --- Credentials (the SUB-ACCOUNT's own API key/secret -- NOT the main account) ---
DELTA_API_KEY=your_sub_account_api_key_here
DELTA_API_SECRET=your_sub_account_api_secret_here

# --- Exchange ---
DELTA_TESTNET=false
DELTA_REGION=india
DELTA_SYMBOL=BTCUSD

# --- Strategy ---
DELTA_STRATEGY=supertrend
DELTA_OPTIONS_MODE=true
DELTA_OPTION_SIDE=sell
DELTA_TARGET_PREMIUM=1000

# --- SupertrendFixedSl pattern settings ---
DELTA_SUPERTREND_ATR_PERIOD=10
DELTA_SUPERTREND_FACTOR=3.0
DELTA_SUPERTREND_TRADE_CE=true
DELTA_SUPERTREND_TRADE_PE=true

# --- Trailing SL (this config's whole point): the active stop re-derives
# from Supertrend's own CURRENT value every bar -- tightening only, never
# loosening -- instead of staying frozen at the flip. false (default
# elsewhere) = frozen; true here = trailing. ---
DELTA_SUPERTREND_TRAILING_SL=true

# --- No premium-decay TP, no trend filter -- pure Supertrend flip timing
# with a trailing stop as the only exit besides square-off. Leave these off
# (their defaults) unless you deliberately want to layer them on top. ---
DELTA_SUPERTREND_TAKE_PROFIT_PCT=0
DELTA_SUPERTREND_TREND_FILTER=false

# --- Settlement gap (blocks NEW entries only, both legs) -- this is also
# effectively "start selling after 17:30": entries are blocked 17:25-17:30
# daily and resume the instant the gap ends, so trading runs continuously
# from 17:30 through to next day's 17:25 square-off. ---
DELTA_SUPERTREND_GAP_START_HOUR=17
DELTA_SUPERTREND_GAP_START_MINUTE=25
DELTA_SUPERTREND_GAP_END_HOUR=17
DELTA_SUPERTREND_GAP_END_MINUTE=30

# --- Weekend: EMPTY = 24/7. ---
DELTA_SKIP_WEEKDAYS=

# --- Day boundary / square-off. No rollover concept -- a closed leg just
# ends; a fresh flip re-arms from scratch. ---
DELTA_SQUARE_OFF_HOUR=17
DELTA_SQUARE_OFF_MINUTE=25

# --- Warmup (ATR(10) needs little history; generous defaults regardless) ---
DELTA_WARMUP_CANDLES=200
DELTA_WARMUP_DAYS=3

# --- Sizing --------------------------------------------------------------------
# This engine has NEVER traded live -- watch the first several entries/exits
# closely (Telegram + docker logs) before trusting it unattended, especially
# since it can hold TWO legs at once.
DELTA_OPTION_CONTRACTS=10
DELTA_OPTION_LEVERAGE=50

# --- State file (own sub-account, distinct from any other bot's). The engine
#     derives TWO per-leg files from this one setting:
#     state/sellingonly_pos_short.json (CE) and state/sellingonly_pos_long.json (PE). ---
DELTA_STATE_FILE=state/sellingonly_pos.json

# --- Telegram (reuse the SAME token + chat ID as your other bots -- bot_label
#     tags every message so you can tell this bot's signals apart) ---
DELTA_TELEGRAM_TOKEN=same_token_as_your_other_bots
DELTA_TELEGRAM_CHAT_ID=same_chat_id_as_your_other_bots
DELTA_BOT_LABEL=SellingOnly

# --- Operational ---
DELTA_CLOSE_ON_SHUTDOWN=false
DELTA_LOG_LEVEL=INFO
DELTA_SUPERTREND_DEBUG_STATE=false
