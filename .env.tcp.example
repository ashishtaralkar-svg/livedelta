# Copy this to .env.tcp and fill in your credentials.
# This file is safe to commit; .env.tcp is gitignored.
#
# INTENDED TO RUN ON A SEPARATE DELTA SUB-ACCOUNT (its own capital/API keys),
# as an independent container parallel to the other bots. Do NOT point this
# at an account already running another bot -- separate capital means they
# can never collide on position ownership.

# --- Credentials (the SUB-ACCOUNT's own API key/secret -- NOT the main account) ---
DELTA_API_KEY=your_sub_account_api_key_here
DELTA_API_SECRET=your_sub_account_api_secret_here

# --- Exchange ---
DELTA_TESTNET=false
DELTA_REGION=india
DELTA_SYMBOL=BTCUSD

# --- Strategy: TCP (Three Candle Pattern) -- a 3-EXACT-consecutive-bar Heikin
# Ashi pattern (no EMA gate; see src/deltabot/strategy/tcp.py for the full
# rule set). BUYS options: a SELL(bearish) pattern trigger buys a CALL, a
# BUY(bullish) pattern trigger buys a PUT. Max loss per trade is capped at the
# premium paid -- no margin/leverage concept, unlike selling.
# Best backtest (5m, buy, 400 premium, 50% TP, Mon-Sat, 25 lots, 1 MONTH only):
# +$84.87 net (68 legs, 52.9% WR). See three_candle_buy_1mo_v3_50pct.xlsx.
# HONESTY: only 1 month of backtest history, and this engine has NEVER traded
# live -- treat live results with real caution for the first few weeks. This
# is also a NEWER, less-tested strategy than dcv2/dcv3 -- start small.
DELTA_STRATEGY=tcp
DELTA_OPTIONS_MODE=true
DELTA_OPTION_SIDE=buy
DELTA_TARGET_PREMIUM=400
# Rally take-profit: close when the BOUGHT option's premium rises this %
# (50 -> entry 400 -> TP 600).
DELTA_TAKE_PROFIT_PCT=50

# --- TCP (Three Candle Pattern) settings ---
DELTA_DCV2_DC_PERIOD=20
# ASAP intracandle ENTRY + SL. Set false to run strictly closed-bar (exactly
# matches the backtest).
DELTA_DCV2_INTRACANDLE_ENABLED=true
# Poll the bought option's mark this often (seconds) for the rally TP.
DELTA_DCV2_TP_POLL_SECONDS=5
# Flatten the whole trade at Saturday's 17:25 square-off (validated Mon-Sat
# config -- see the dcv2-mon-sat-weekend finding: trading through Fri->Sat and
# flattening before Sunday beat both full Fri-flat and full 24/7 for the
# underlying signal family. Re-validate for this specific pattern before
# trusting it blindly; the backtest above used Mon-Sat too).
DELTA_DCV2_WEEKEND_FLAT=true
# Re-buy a fresh ~target-premium option at 17:30 while the directional trade
# is still open (daily rollover).
DELTA_DCV2_ROLLOVER_ENABLED=true
# Remove the 17:25-17:30 settlement gap: close AND immediately re-buy the
# still-open directional trade's option in the SAME 17:25 event instead of
# waiting 5 minutes. false = closed-bar rollover at 17:30 (unchanged) if left unset.
DELTA_DCV2_CONTINUOUS_ROLL=false

# --- Weekend block: Mon-Sat (skip Sunday only), matching the backtested config. ---
DELTA_SKIP_WEEKDAYS=Sun

# --- Day boundary: trade "day" starts 17:30 IST (Delta options settlement). ---
DELTA_DAY_START_HOUR=17
DELTA_DAY_START_MINUTE=30
DELTA_SQUARE_OFF_HOUR=17
DELTA_SQUARE_OFF_MINUTE=25
DELTA_ENTRY_RESUME_HOUR=17
DELTA_ENTRY_RESUME_MINUTE=30

# --- Warmup (need >=20 5m bars for the Donchian(20); 3 days = 864 bars is
# plenty of headroom). ---
DELTA_WARMUP_CANDLES=200
DELTA_WARMUP_DAYS=3

# --- Sizing --------------------------------------------------------------------
# This engine has NEVER traded live -- start at 1 lot, run it for at least a
# few days, and reconcile live fills (entry/rollover/TP/SL timing) against the
# backtest BEFORE scaling toward the backtested target (25 lots).
DELTA_OPTION_CONTRACTS=1

# --- State file (own sub-account, but keep this path distinct from any other bot's) ---
DELTA_STATE_FILE=state/tcp_pos.json

# --- Telegram (reuse the SAME token + chat ID as your other bots -- bot_label
#     tags every message so you can tell this bot's signals apart) ---
DELTA_TELEGRAM_TOKEN=same_token_as_your_other_bots
DELTA_TELEGRAM_CHAT_ID=same_chat_id_as_your_other_bots
DELTA_BOT_LABEL=TCP

# --- Operational ---
DELTA_CLOSE_ON_SHUTDOWN=false
DELTA_LOG_LEVEL=INFO
# Diagnostic: log a full strategy-state snapshot on every closed 5m candle
# (sell/buy hunt state, pending/pos). ~288 lines/day. Turn on to capture WHY a
# signal did/didn't fire, minute-by-minute, from the bot's own live data.
# Leave false unless investigating.
DELTA_DCV2_DEBUG_STATE=false
