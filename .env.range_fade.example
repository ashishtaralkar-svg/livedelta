# Copy this to .env.range_fade and fill in your credentials.
# This file is safe to commit; .env.range_fade is gitignored.
#
# INTENDED TO RUN ON A SEPARATE DELTA SUB-ACCOUNT (its own capital/API keys),
# as an independent container parallel to the other bots. Do NOT point this
# at an account already running another bot -- separate capital means they
# can never collide on position ownership.

# --- Credentials (the SUB-ACCOUNT's own API key/secret -- NOT the main account) ---
DELTA_API_KEY=your_sub_account_api_key_here
DELTA_API_SECRET=your_sub_account_api_secret_here

# --- Exchange ---
DELTA_TESTNET=false
DELTA_REGION=india
DELTA_SYMBOL=BTCUSD

# --- Strategy: Range Engulfing Fade (sell-only, INTRACANDLE) -- a red candle
# followed by a green candle whose range fully engulfs it arms a trigger at
# the green candle's high. The trigger is live for exactly ONE candle: the
# very next one. This is the FIRST engine in the fleet that reacts in real
# time WITHIN a forming candle (every other bot only acts at candle close) --
# the moment real price crosses the trigger, it SELLS an AT-THE-MONEY CALL,
# not up to 15 minutes later. SL/TARGET are the pattern's own height/low,
# fixed 1:1 risk:reward -- no premium target, no rally TP. Exits the same
# way: the instant price touches SL or TARGET, not at candle close.
# ATM execution REQUIRES DELTA_OPTION_OFFSET=0 below (OptionsExecutor.
# open_option() picks strike = round(btc_price / DELTA_OPTION_STRIKE_INTERVAL)
# with offset 0 -- pure ATM, not the ITM offset every other selling bot uses).
# Backtested (scripts/backtest_range_engulfing_fade_sell.py, 15m signal, 1m
# option-close premiums, ATM, 10 lots): 7d -$3.35/12 legs/50.0% WR, 30d
# -$13.61/54 legs/40.7% WR -- net NEGATIVE on both windows tested so far.
# Fees are a meaningful share of the drag; the core issue is that SL losses
# run larger on average than TARGET wins even at "fair" 1:1 R:R, because the
# option premium's reaction to an adverse BTC move is convex.
# HONESTY: this strategy has NEVER executed a real order, AND this is the
# first engine using real-time intracandle execution at all (new code path,
# no live precedent in this fleet to lean on) -- start at
# DELTA_OPTION_CONTRACTS=1 (below) and watch every single entry/exit closely.
# Do not raise the lot size until you've confirmed live fills match what you
# expect on both entry timing and the SL/TARGET levels.
DELTA_STRATEGY=range_fade
DELTA_OPTIONS_MODE=true
DELTA_OPTION_SIDE=sell
# 0 = pure ATM (this strategy has no ITM/OTM concept -- REQUIRED, do not change).
DELTA_OPTION_OFFSET=0

# --- Day boundary / square-off. No rollover concept (a closed setup just
# ends; a fresh pattern re-arms from scratch), so only the square-off time
# matters. ---
DELTA_SQUARE_OFF_HOUR=17
DELTA_SQUARE_OFF_MINUTE=25

# --- Weekend: EMPTY = 24/7. The backtest never excluded weekends, so live
# starts matching that (no Sat/Sun entry block; an already-open leg still
# exits normally on the daily square-off regardless). ---
DELTA_SKIP_WEEKDAYS=

# --- Warmup (this pattern needs almost no history -- just 1 prior closed
# candle -- generous defaults regardless) ---
DELTA_WARMUP_CANDLES=50
DELTA_WARMUP_DAYS=2

# --- Sizing ----------------------------------------------------------------
# See the HONESTY note above -- start at 1 and raise only after watching
# several real, correctly-timed entries/exits.
DELTA_OPTION_CONTRACTS=1

# --- State file (own sub-account, but keep this path distinct from any other bot's) ---
DELTA_STATE_FILE=state/range_fade_pos.json

# --- Telegram (reuse the SAME token + chat ID as your other bots -- bot_label
#     tags every message so you can tell this bot's signals apart) ---
DELTA_TELEGRAM_TOKEN=same_token_as_your_other_bots
DELTA_TELEGRAM_CHAT_ID=same_chat_id_as_your_other_bots
DELTA_BOT_LABEL=RANGEFADE

# --- Operational ---
DELTA_CLOSE_ON_SHUTDOWN=false
DELTA_LOG_LEVEL=INFO
# Diagnostic: log a full strategy-state snapshot on every closed 15m candle.
# ~96 lines/day. Turn on to capture WHY a pattern did/didn't arm from the
# bot's own live data. Leave false unless investigating.
DELTA_RANGE_FADE_DEBUG_STATE=false
