# Copy this to .env.emaside9pm and fill in your credentials.
# This file is safe to commit; .env.emaside9pm is gitignored.
#
# RUN ON ITS OWN DELTA SUB-ACCOUNT (own capital/API keys) -- never on an account
# already used by another bot.

# --- Credentials (the SUB-ACCOUNT's own API key/secret) ---
DELTA_API_KEY=your_sub_account_api_key_here
DELTA_API_SECRET=your_sub_account_api_secret_here

# --- Exchange ---
DELTA_TESTNET=false
DELTA_REGION=india
DELTA_SYMBOL=BTCUSD

# --- Strategy: 9PM EMA50/EMA200 one-side option SELL --------------------------
# From 21:00 IST, on every closed 5m BTC candle:
#   close > EMA50 > EMA200 -> SELL a PUT  |  close < EMA50 < EMA200 -> SELL a CALL
#   anything else          -> wait for a later 5m close (until 17:00 next day)
# Strike = listed strike nearest DELTA_EMASIDE_OTM_PCT%% from spot (0 = ATM),
# next-day expiry. ONE trade per session.
# Exits: TARGET premium decayed DELTA_EMASIDE_TARGET_PCT%%, SL premium rose
# DELTA_EMASIDE_SL_PCT%%, else bought back at 17:00 next day.
# Backtest (scripts/backtest_9pm_ema_side_sell.py --stacked --otm-pct 0
# --target-pct 70 --sl-pct 100), 400 lots: Aug-Nov +$2,283, May-Aug +$829,
# max DD -$786, worst trade -$322  (=> at 50 lots: ~1/8 of those).
DELTA_STRATEGY=emaside9pm
DELTA_OPTIONS_MODE=true
DELTA_OPTION_SIDE=sell

DELTA_EMASIDE_ENTRY_HOUR=21
DELTA_EMASIDE_ENTRY_MINUTE=0
DELTA_EMASIDE_EXIT_HOUR=17
DELTA_EMASIDE_EXIT_MINUTE=0
DELTA_EMASIDE_OTM_PCT=0
DELTA_EMASIDE_TARGET_PCT=70
DELTA_EMASIDE_SL_PCT=100
DELTA_EMASIDE_FAST=50
DELTA_EMASIDE_SLOW=200
DELTA_EMASIDE_RESOLUTION=5m

# Sessions starting on these IST days are skipped (backtest: Sat,Sun skipped).
DELTA_SKIP_WEEKDAYS=Sat,Sun

# --- Sizing ---
DELTA_OPTION_CONTRACTS=50
# Leverage set on the option product right before selling (0 = exchange default).
DELTA_OPTION_LEVERAGE=50

# --- State files (engine also writes state/emaside9pm_pos_session.json) ---
DELTA_STATE_FILE=state/emaside9pm_pos.json

# --- Telegram (same token/chat as the other bots; the label tags messages) ---
DELTA_TELEGRAM_TOKEN=same_token_as_your_other_bots
DELTA_TELEGRAM_CHAT_ID=same_chat_id_as_your_other_bots
DELTA_BOT_LABEL=EMASIDE9PM

# --- Operational ---
DELTA_CLOSE_ON_SHUTDOWN=false
DELTA_LOG_LEVEL=INFO
