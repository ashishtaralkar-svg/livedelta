# Copy this to .env.weeklyhedge and fill in your credentials.
# This file is safe to commit; .env.weeklyhedge is gitignored.
#
# RUN ON ITS OWN DELTA SUB-ACCOUNT. The bot refuses to open a new week while ANY
# option position it does not own is open on the account.

# --- Credentials (the SUB-ACCOUNT's own API key/secret) ---
DELTA_API_KEY=your_sub_account_api_key_here
DELTA_API_SECRET=your_sub_account_api_secret_here

# --- Exchange ---
DELTA_TESTNET=false
DELTA_REGION=india
DELTA_SYMBOL=BTCUSD

# --- Strategy: DAILY short strangle + breakeven hedge ---
# Every day 21:00 IST: sell CE+PE ~2% away on the NEXT-DAY expiry
# (DELTA_WEEKLY_CYCLE=weekly instead = Fridays only, next Friday's expiry).
# Breakevens = CE strike + combined premium / PE strike - combined premium.
# A closed 1m BTC candle beyond a breakeven buys ONE hedge on that side,
# HEDGE_OFFSET_PCT (% of entry spot) further out, same expiry and lots, held to expiry.
# Everything closes at 17:25 IST on expiry day. No target / SL.
# Backtest (scripts/backtest_weekly_strangle_breakeven_hedge.py --daily-expiry
# --otm-pct 2 --hedge-offset-pct 1, 15 lots, 30 days): +$29.24, 27/30 days won.
DELTA_STRATEGY=weeklyhedge
DELTA_OPTIONS_MODE=true
DELTA_OPTION_SIDE=sell
DELTA_WEEKLY_ENTRY_WEEKDAY=4
DELTA_WEEKLY_ENTRY_HOUR=21
DELTA_WEEKLY_ENTRY_MINUTE=0
DELTA_WEEKLY_EXIT_HOUR=17
DELTA_WEEKLY_EXIT_MINUTE=25
DELTA_WEEKLY_CYCLE=daily
DELTA_WEEKLY_OTM_PCT=2.0
DELTA_WEEKLY_HEDGE_OFFSET_PCT=1.0

# --- Sizing: fixed lots for every leg (sold CE, sold PE, each hedge). ---
# Start at 1 lot: this engine has never traded live.
DELTA_OPTION_CONTRACTS=1
DELTA_OPTION_LEVERAGE=50

# --- State files (the engine derives _ce/_pe/_hce/_hpe/_meta files from this) ---
DELTA_STATE_FILE=state/weeklyhedge_pos.json

# --- Telegram (same token + chat ID as your other bots) ---
DELTA_TELEGRAM_TOKEN=same_token_as_your_other_bots
DELTA_TELEGRAM_CHAT_ID=same_chat_id_as_your_other_bots
DELTA_BOT_LABEL=WEEKLYHEDGE

# --- Operational ---
DELTA_CLOSE_ON_SHUTDOWN=false
DELTA_LOG_LEVEL=INFO
