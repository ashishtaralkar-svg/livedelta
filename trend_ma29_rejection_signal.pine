//@version=5
// ============================================================================
// TREND + MA29 REJECTION — SIGNAL ONLY (no trade execution, no strategy.*)
//
// SELL setup (all conditions on the SAME signal candle):
//   * EMA(150) < EMA(600) -- bearish macro trend regime.
//   * close < EMA(29) < SMA(29) -- a fully bearish-aligned MA stack: price
//     below BOTH the 29 EMA and the 29 SMA, and the faster 29 EMA itself
//     below the slower 29 SMA (the EMA reacts quicker, so it having already
//     dropped below the SMA confirms the short-term slide is still fresh,
//     not just a stale/old decline) -- a downtrend-continuation setup.
//   * OPEN == HIGH on that candle (tick-tolerant) -- no upper wick at all,
//     sellers in control from the first tick; the bearish rejection shape.
//   -> that candle only ARMS a pending SELL trigger at its LOW (does NOT
//      enter yet). A LATER candle's LOW BREAKING BELOW that armed level is
//      what actually fires the SELL signal, with entry = the broken level
//      itself (the armed low), not the breaking candle's own close.
//   SL: NOT a fixed price -- a LATER candle CLOSING back above SMA(29)
//       (checked every bar using SMA(29)'s then-current, still-updating
//       value, not frozen at entry).
//   TARGET: entry - 1% (fixed the instant the signal fires), touch-based
//       (a later candle's low reaching it).
//   Priority when both could resolve on the same bar: SL checked first
//   (conservative -- same convention as ema21_rejection_pullback_strategy
//   and every other multi-exit script in this repo).
//
// BUY setup is the exact mirror: EMA(150) > EMA(600), SMA(29) < EMA(29) <
// close, OPEN == LOW -- arms a pending BUY trigger at that candle's HIGH; a
// later candle's HIGH BREAKING ABOVE it fires the signal (entry = that armed
// high). SL = a later close back BELOW SMA(29), TARGET = entry + 1%.
//
// ARM/BREAK MECHANICS: only one setup can be pending (armed but not yet
// triggered) per side at a time -- a fresh signal candle does NOT re-arm
// over an already-pending one (it's simply ignored while one is pending).
// No expiry/invalidation on a pending arm -- it waits indefinitely for its
// break, however many bars that takes, unless the block conditions below
// activate first (which only gate NEW arms, not an already-pending one).
//
// A side only hunts for its NEXT signal once its current one has resolved
// (SL or TARGET) -- purely so the plotted entry/target lines never overlap.
// This is NOT a trading strategy, so there's no position sizing or
// pyramiding concept at all -- both sides could in principle be "active"
// at once, though in practice the trend-regime gate (EMA150 vs EMA600)
// makes sell and buy setups mutually exclusive at any given bar anyway.
//
// POST-TARGET BLOCK (added on request): a TARGET hit (NOT an SL hit) blocks
// that side from any new entry until EMA(29) and SMA(29) cross again -- the
// EMA29-vs-SMA29 relationship is captured the instant the target fires, and
// the block releases the first bar that relationship flips. SL exits re-arm
// immediately as before; only TARGET exits trigger this cooldown.
//
// SIGNAL ONLY -- no strategy.entry/close, no backtest equity curve. Same
// "signal indicator" convention as tcp_pattern_signal.pine elsewhere in
// this repo (use TradingView alerts on the alertcondition()s below if you
// want a notification the moment a setup fires or resolves).
//
// NOT YET BACKTESTED -- a fresh port, not a validated setup.
// ============================================================================
indicator("Trend + MA29 Rejection Signal", overlay=true, max_labels_count=500)

// ============================================================
// Inputs
// ============================================================
trendFastLen = input.int(150, "Trend EMA Fast Length", minval=1, group="Trend filter")
trendSlowLen = input.int(600, "Trend EMA Slow Length", minval=1, group="Trend filter")
maLen        = input.int(29,  "EMA/SMA Length", minval=1, group="MA29")
targetPct    = input.float(1.0, "Target %", minval=0.01, group="Exit") / 100.0

// ============================================================
// Indicators, all on real close.
// ============================================================
emaTrendFast = ta.ema(close, trendFastLen)
emaTrendSlow = ta.ema(close, trendSlowLen)
ema29 = ta.ema(close, maLen)
sma29 = ta.sma(close, maLen)

plot(emaTrendFast, "Trend EMA Fast", color=color.new(color.blue, 0),   linewidth=1)
plot(emaTrendSlow, "Trend EMA Slow", color=color.new(color.purple, 0), linewidth=1)
plot(ema29, "EMA 29", color=color.new(color.aqua, 0),   linewidth=2)
plot(sma29, "SMA 29", color=color.new(color.orange, 0), linewidth=2)

eq(a, b) => math.abs(a - b) <= syminfo.mintick

// ============================================================
// Setup conditions (checked on the closed candle itself).
// ============================================================
sellTrendOk = emaTrendFast < emaTrendSlow
sellMaOk    = close < ema29 and ema29 < sma29
sellShapeOk = eq(open, high)
sellSetup   = sellTrendOk and sellMaOk and sellShapeOk

buyTrendOk  = emaTrendFast > emaTrendSlow
buyMaOk     = sma29 < ema29 and ema29 < close
buyShapeOk  = eq(open, low)
buySetup    = buyTrendOk and buyMaOk and buyShapeOk

// ============================================================
// State — one active setup per side at a time (re-arms once resolved).
// ============================================================
var bool  sellActive = false
var float sellEntry  = na
var float sellTarget = na

var bool  buyActive = false
var float buyEntry  = na
var float buyTarget = na

// Pending arm state -- a signal candle arms one of these; a LATER candle's
// low (sell) / high (buy) breaking through the armed level fires the entry.
var bool  sellPending    = false
var float sellPendingLow = na

var bool  buyPending      = false
var float buyPendingHigh  = na

// Post-TARGET block (added on request): once a side's TARGET is hit (SL
// does NOT arm this), no new entry on that side until EMA(29) and SMA(29)
// cross again -- i.e. their relative order flips from whatever it was
// the instant the target fired.
var bool sellBlocked      = false
var bool sellBlockedAbove = false   // ema29 > sma29, captured at the TARGET hit
var bool buyBlocked       = false
var bool buyBlockedAbove  = false

ema29AboveSma29 = ema29 > sma29

sellFired = false
buyFired  = false
sellExitFired = false
buyExitFired  = false
sellExitReason = ""
buyExitReason  = ""
sellExitPrice = 0.0
buyExitPrice  = 0.0

// ----- SELL side -----
// Flat (single-level) ifs on purpose -- no nested if/else-if chains, so
// there's no deeper indentation level to get mangled by a copy-paste.
sellSlHit  = sellActive and close > sma29
sellTpHit  = sellActive and not sellSlHit and low <= sellTarget
sellJustExited = sellSlHit or sellTpHit

if sellSlHit
    sellExitFired := true
    sellExitReason := "SL"
    sellExitPrice := close
    sellActive := false
    sellEntry := na
    sellTarget := na

if sellTpHit
    sellExitFired := true
    sellExitReason := "TARGET"
    sellExitPrice := sellTarget
    sellActive := false
    sellEntry := na
    sellTarget := na
    sellBlocked := true
    sellBlockedAbove := ema29AboveSma29

sellCrossReleased = sellBlocked and ema29AboveSma29 != sellBlockedAbove
if sellCrossReleased
    sellBlocked := false

// Trigger check FIRST, using sellPending/sellPendingLow as they stood
// BEFORE this bar (a level armed later below can't trigger on its own bar).
sellTriggerHit = sellPending and low <= sellPendingLow
if sellTriggerHit
    sellEntry := sellPendingLow
    sellTarget := sellPendingLow * (1 - targetPct)
    sellActive := true
    sellFired := true
    sellPending := false
    sellPendingLow := na

// Arm check LAST -- a fresh arm here can only be evaluated for its break
// starting the NEXT bar.
if not sellActive and not sellPending and not sellJustExited and not sellBlocked and sellSetup
    sellPending := true
    sellPendingLow := low

// ----- BUY side (mirror) -----
buySlHit  = buyActive and close < sma29
buyTpHit  = buyActive and not buySlHit and high >= buyTarget
buyJustExited = buySlHit or buyTpHit

if buySlHit
    buyExitFired := true
    buyExitReason := "SL"
    buyExitPrice := close
    buyActive := false
    buyEntry := na
    buyTarget := na

if buyTpHit
    buyExitFired := true
    buyExitReason := "TARGET"
    buyExitPrice := buyTarget
    buyActive := false
    buyEntry := na
    buyTarget := na
    buyBlocked := true
    buyBlockedAbove := ema29AboveSma29

buyCrossReleased = buyBlocked and ema29AboveSma29 != buyBlockedAbove
if buyCrossReleased
    buyBlocked := false

// Trigger check FIRST, using buyPending/buyPendingHigh as they stood
// BEFORE this bar (a level armed later below can't trigger on its own bar).
buyTriggerHit = buyPending and high >= buyPendingHigh
if buyTriggerHit
    buyEntry := buyPendingHigh
    buyTarget := buyPendingHigh * (1 + targetPct)
    buyActive := true
    buyFired := true
    buyPending := false
    buyPendingHigh := na

// Arm check LAST -- a fresh arm here can only be evaluated for its break
// starting the NEXT bar.
if not buyActive and not buyPending and not buyJustExited and not buyBlocked and buySetup
    buyPending := true
    buyPendingHigh := high

// ============================================================
// Plotting / markers
// ============================================================
sellArmed = sellPending and not sellPending[1]
buyArmed  = buyPending and not buyPending[1]
plotshape(sellArmed, title="SELL armed", style=shape.circle, location=location.abovebar,
     color=color.new(color.maroon, 0), size=size.tiny)
plotshape(buyArmed, title="BUY armed", style=shape.circle, location=location.belowbar,
     color=color.new(color.olive, 0), size=size.tiny)

plotshape(sellFired, title="SELL signal", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.small, text="SELL")
plotshape(buyFired, title="BUY signal", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.green, 0), size=size.small, text="BUY")

plot(sellPending ? sellPendingLow  : na, "Sell pending trigger (low break)", color=color.new(color.maroon, 0), style=plot.style_linebr, linewidth=1)
plot(buyPending  ? buyPendingHigh  : na, "Buy pending trigger (high break)", color=color.new(color.olive, 0),  style=plot.style_linebr, linewidth=1)

plot(sellActive ? sellEntry  : na, "Sell entry",  color=color.new(color.gray, 0),  style=plot.style_linebr, linewidth=1)
plot(sellActive ? sellTarget : na, "Sell target", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(buyActive  ? buyEntry   : na, "Buy entry",   color=color.new(color.gray, 0),  style=plot.style_linebr, linewidth=1)
plot(buyActive  ? buyTarget  : na, "Buy target",  color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)

bgcolor(sellBlocked ? color.new(color.red, 90)   : na, title="Sell blocked (post-target, awaiting EMA29/SMA29 cross)")
bgcolor(buyBlocked  ? color.new(color.green, 90) : na, title="Buy blocked (post-target, awaiting EMA29/SMA29 cross)")

if sellFired
    label.new(bar_index, sellEntry, "SELL " + str.tostring(sellEntry, format.mintick),
         style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
if buyFired
    label.new(bar_index, buyEntry, "BUY " + str.tostring(buyEntry, format.mintick),
         style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small)
if sellExitFired
    label.new(bar_index, sellExitPrice, sellExitReason + " " + str.tostring(sellExitPrice, format.mintick),
         style=label.style_label_left, color=sellExitReason == "TARGET" ? color.new(color.green, 0) : color.new(color.maroon, 0),
         textcolor=color.white, size=size.small)
if buyExitFired
    label.new(bar_index, buyExitPrice, buyExitReason + " " + str.tostring(buyExitPrice, format.mintick),
         style=label.style_label_left, color=buyExitReason == "TARGET" ? color.new(color.green, 0) : color.new(color.maroon, 0),
         textcolor=color.white, size=size.small)

alertcondition(sellFired, title="Sell Setup", message="Trend+MA29: SELL setup fired")
alertcondition(buyFired,  title="Buy Setup",  message="Trend+MA29: BUY setup fired")
alertcondition(sellExitFired, title="Sell Exit", message="Trend+MA29: SELL setup resolved")
alertcondition(buyExitFired,  title="Buy Exit",  message="Trend+MA29: BUY setup resolved")
